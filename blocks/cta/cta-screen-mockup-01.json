{
  "root": "cta-screen-mockup-01",
  "elements": {
    "cta-screen-mockup-01": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": 10,
        "padding": [
          24,
          0
        ]
      },
      "children": [
        "container"
      ]
    },
    "container": {
      "type": "Grid",
      "props": {
        "columns": 2,
        "gap": 16,
        "container": "wide",
        "align": "center"
      },
      "children": [
        "left-content",
        "screen-mockup"
      ]
    },
    "left-content": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": 8
      },
      "children": [
        "text-block",
        "button-group"
      ]
    },
    "text-block": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": 6
      },
      "children": [
        "heading",
        "description",
        "check-list"
      ]
    },
    "heading": {
      "type": "Text",
      "props": {
        "tag": "h2",
        "content": "Beautiful analytics to grow smarter"
      }
    },
    "description": {
      "type": "Text",
      "props": {
        "tag": "p",
        "content": "Powerful, self-serve product and growth analytics.",
        "variant": "secondary"
      }
    },
    "check-list": {
      "type": "List",
      "props": {
        "variant": "check",
        "gap": 4
      },
      "children": [
        "check-item-1",
        "check-item-2",
        "check-item-3"
      ]
    },
    "check-item-1": {
      "type": "Text",
      "props": {
        "tag": "span",
        "content": "Share team inboxes"
      }
    },
    "check-item-2": {
      "type": "Text",
      "props": {
        "tag": "span",
        "content": "Deliver instant answers"
      }
    },
    "check-item-3": {
      "type": "Text",
      "props": {
        "tag": "span",
        "content": "Manage your team with reports"
      }
    },
    "button-group": {
      "type": "ButtonGroup",
      "children": [
        "btn-outline",
        "btn-primary"
      ]
    },
    "btn-outline": {
      "type": "Button",
      "props": {
        "label": "Learn more",
        "variant": "outline",
        "size": "lg"
      }
    },
    "btn-primary": {
      "type": "Button",
      "props": {
        "label": "Get started",
        "variant": "primary",
        "size": "lg"
      }
    },
    "screen-mockup": {
      "type": "Image",
      "props": {
        "src": "https://picsum.photos/seed/cta-screen-mockup-01-screen-mockup/800/533",
        "alt": "Dashboard mockup"
      }
    }
  }
}
