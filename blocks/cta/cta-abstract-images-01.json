{
  "root": "cta-abstract-images-01",
  "elements": {
    "cta-abstract-images-01": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": 10,
        "padding": [
          24,
          0
        ]
      },
      "children": [
        "layout-grid"
      ]
    },
    "layout-grid": {
      "type": "Grid",
      "props": {
        "columns": 2,
        "gap": 16,
        "container": "wide",
        "align": "center"
      },
      "children": [
        "content-side",
        "collage-side"
      ]
    },
    "content-side": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": 8
      },
      "children": [
        "content-inner",
        "buttons"
      ]
    },
    "content-inner": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": 6
      },
      "children": [
        "heading",
        "description"
      ]
    },
    "heading": {
      "type": "Text",
      "props": {
        "tag": "h2",
        "content": "No long-term contracts. No catches."
      }
    },
    "description": {
      "type": "Text",
      "props": {
        "tag": "p",
        "content": "Start your 30-day free trial today.",
        "variant": "muted"
      }
    },
    "buttons": {
      "type": "ButtonGroup",
      "children": [
        "btn-outline",
        "btn-primary"
      ]
    },
    "btn-outline": {
      "type": "Button",
      "props": {
        "label": "Learn more",
        "variant": "outline",
        "size": "lg"
      }
    },
    "btn-primary": {
      "type": "Button",
      "props": {
        "label": "Get started",
        "variant": "primary",
        "size": "lg"
      }
    },
    "collage-side": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": 4
      },
      "children": [
        "collage-top-row",
        "collage-bottom-row"
      ]
    },
    "collage-top-row": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": 4
      },
      "children": [
        "abstract-1",
        "abstract-2"
      ]
    },
    "collage-bottom-row": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": 4
      },
      "children": [
        "abstract-3",
        "abstract-4",
        "abstract-5"
      ]
    },
    "abstract-1": {
      "type": "Image",
      "props": {
        "src": "https://picsum.photos/seed/cta-abstract-images-01-abstract-1/160/240",
        "alt": "Abstract 1"
      }
    },
    "abstract-2": {
      "type": "Image",
      "props": {
        "src": "https://picsum.photos/seed/cta-abstract-images-01-abstract-2/160/240",
        "alt": "Abstract 2"
      }
    },
    "abstract-3": {
      "type": "Image",
      "props": {
        "src": "https://picsum.photos/seed/cta-abstract-images-01-abstract-3/192/128",
        "alt": "Abstract 3"
      }
    },
    "abstract-4": {
      "type": "Image",
      "props": {
        "src": "https://picsum.photos/seed/cta-abstract-images-01-abstract-4/160/128",
        "alt": "Abstract 4"
      }
    },
    "abstract-5": {
      "type": "Image",
      "props": {
        "src": "https://picsum.photos/seed/cta-abstract-images-01-abstract-5/192/128",
        "alt": "Abstract 5"
      }
    }
  }
}
