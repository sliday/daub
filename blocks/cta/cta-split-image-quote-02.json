{
  "root": "cta-split-image-quote-02",
  "elements": {
    "cta-split-image-quote-02": {
      "type": "Grid",
      "props": {
        "columns": 2,
        "gap": 0
      },
      "children": [
        "left-col",
        "right-col"
      ]
    },
    "left-col": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": 0
      },
      "children": [
        "left-image",
        "quote-surface"
      ]
    },
    "left-image": {
      "type": "Image",
      "props": {
        "src": "https://picsum.photos/seed/cta-split-image-quote-02-left-image/720/400",
        "alt": "CTA hero",
        "objectFit": "cover"
      }
    },
    "quote-surface": {
      "type": "Surface",
      "props": {
        "variant": "muted",
        "padding": 6
      },
      "children": [
        "quote-inner"
      ]
    },
    "quote-inner": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": 4
      },
      "children": [
        "quote-text",
        "quote-author-row"
      ]
    },
    "quote-text": {
      "type": "Text",
      "props": {
        "tag": "p",
        "content": "We've been using Daub to kick start every new project and can't imagine working without it.",
        "style": "italic"
      }
    },
    "quote-author-row": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": 3,
        "align": "center"
      },
      "children": [
        "quote-avatar",
        "quote-author-info"
      ]
    },
    "quote-avatar": {
      "type": "Avatar",
      "props": {
        "initials": "OR",
        "size": "sm"
      }
    },
    "quote-author-info": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": 0
      },
      "children": [
        "quote-author-name",
        "quote-author-role"
      ]
    },
    "quote-author-name": {
      "type": "Text",
      "props": {
        "tag": "span",
        "content": "Olivia Rhye"
      }
    },
    "quote-author-role": {
      "type": "Text",
      "props": {
        "tag": "span",
        "content": "Lead Designer, Layers",
        "variant": "muted"
      }
    },
    "right-col": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": 8,
        "padding": [
          24,
          8
        ],
        "justify": "center",
        "align": "center"
      },
      "children": [
        "right-content",
        "right-actions"
      ]
    },
    "right-content": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": 4,
        "align": "center"
      },
      "children": [
        "right-heading",
        "right-description"
      ]
    },
    "right-heading": {
      "type": "Text",
      "props": {
        "tag": "h2",
        "content": "Start your free trial",
        "align": "center"
      }
    },
    "right-description": {
      "type": "Text",
      "props": {
        "tag": "p",
        "content": "Join over 4,000+ startups already growing with Daub.",
        "variant": "muted",
        "align": "center"
      }
    },
    "right-actions": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": 3
      },
      "children": [
        "btn-learn-more",
        "btn-get-started"
      ]
    },
    "btn-learn-more": {
      "type": "Button",
      "props": {
        "label": "Learn more",
        "variant": "outline",
        "size": "lg"
      }
    },
    "btn-get-started": {
      "type": "Button",
      "props": {
        "label": "Get started",
        "variant": "primary",
        "size": "lg"
      }
    }
  }
}
