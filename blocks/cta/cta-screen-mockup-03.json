{
  "root": "cta-screen-mockup-03",
  "elements": {
    "cta-screen-mockup-03": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": 10,
        "align": "center",
        "padding": [
          24,
          0,
          0,
          0
        ]
      },
      "children": [
        "content-block",
        "mockup-image"
      ]
    },
    "content-block": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": 6,
        "align": "center",
        "container": "narrow"
      },
      "children": [
        "text-block",
        "buttons"
      ]
    },
    "text-block": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": 4,
        "align": "center"
      },
      "children": [
        "heading",
        "description"
      ]
    },
    "heading": {
      "type": "Text",
      "props": {
        "tag": "h2",
        "content": "Beautiful analytics to grow smarter",
        "align": "center"
      }
    },
    "description": {
      "type": "Text",
      "props": {
        "tag": "p",
        "content": "Powerful, self-serve product and growth analytics to help you convert, engage, and retain more.",
        "variant": "muted",
        "align": "center"
      }
    },
    "buttons": {
      "type": "ButtonGroup",
      "children": [
        "btn-outline",
        "btn-primary"
      ]
    },
    "btn-outline": {
      "type": "Button",
      "props": {
        "label": "Learn more",
        "variant": "outline",
        "size": "lg"
      }
    },
    "btn-primary": {
      "type": "Button",
      "props": {
        "label": "Get started",
        "variant": "primary",
        "size": "lg"
      }
    },
    "mockup-image": {
      "type": "Image",
      "props": {
        "src": "https://picsum.photos/seed/cta-screen-mockup-03-mockup-image/1024/640",
        "alt": "Dashboard mockup"
      }
    }
  }
}
