{
  "root": "cta-screen-mockup-02",
  "elements": {
    "cta-screen-mockup-02": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": 10,
        "align": "center",
        "padding": [
          24,
          0
        ]
      },
      "children": [
        "top-content",
        "screen-mockup"
      ]
    },
    "top-content": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": 6,
        "align": "center",
        "container": "narrow"
      },
      "children": [
        "text-block",
        "button-group"
      ]
    },
    "text-block": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": 4,
        "align": "center"
      },
      "children": [
        "heading",
        "description"
      ]
    },
    "heading": {
      "type": "Text",
      "props": {
        "tag": "h2",
        "content": "Beautiful analytics to grow smarter",
        "align": "center"
      }
    },
    "description": {
      "type": "Text",
      "props": {
        "tag": "p",
        "content": "Powerful, self-serve product and growth analytics.",
        "variant": "secondary",
        "align": "center"
      }
    },
    "button-group": {
      "type": "ButtonGroup",
      "children": [
        "btn-outline",
        "btn-primary"
      ]
    },
    "btn-outline": {
      "type": "Button",
      "props": {
        "label": "Learn more",
        "variant": "outline",
        "size": "lg"
      }
    },
    "btn-primary": {
      "type": "Button",
      "props": {
        "label": "Get started",
        "variant": "primary",
        "size": "lg"
      }
    },
    "screen-mockup": {
      "type": "Image",
      "props": {
        "src": "https://picsum.photos/seed/cta-screen-mockup-02-screen-mockup/1024/640",
        "alt": "Dashboard mockup"
      }
    }
  }
}
