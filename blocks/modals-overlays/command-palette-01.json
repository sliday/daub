{
  "root": "command-palette-section",
  "elements": {
    "command-palette-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": 0,
        "align": "center",
        "container": "narrow"
      },
      "children": [
        "palette-card"
      ]
    },
    "palette-card": {
      "type": "Card",
      "children": [
        "palette-inner"
      ]
    },
    "palette-inner": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": 3
      },
      "children": [
        "palette-search",
        "palette-divider",
        "palette-results"
      ]
    },
    "palette-search": {
      "type": "Input",
      "props": {
        "placeholder": "Type a command or search...",
        "type": "search"
      }
    },
    "palette-divider": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "palette-results": {
      "type": "List",
      "props": {
        "items": [
          {
            "title": "New Project",
            "icon": "plus",
            "secondary": "Ctrl+N"
          },
          {
            "title": "Open File",
            "icon": "file",
            "secondary": "Ctrl+O"
          },
          {
            "title": "Search Documentation",
            "icon": "search",
            "secondary": "Ctrl+K"
          },
          {
            "title": "Toggle Dark Mode",
            "icon": "moon",
            "secondary": "Ctrl+Shift+D"
          },
          {
            "title": "Invite Team Member",
            "icon": "user-plus",
            "secondary": "Ctrl+I"
          },
          {
            "title": "Go to Dashboard",
            "icon": "layout-dashboard",
            "secondary": "G D"
          },
          {
            "title": "Go to Settings",
            "icon": "settings",
            "secondary": "G S"
          },
          {
            "title": "Go to Projects",
            "icon": "folder",
            "secondary": "G P"
          },
          {
            "title": "Export Data",
            "icon": "download",
            "secondary": "Ctrl+E"
          },
          {
            "title": "View Notifications",
            "icon": "bell",
            "secondary": "Ctrl+Shift+N"
          },
          {
            "title": "Open Terminal",
            "icon": "terminal",
            "secondary": "Ctrl+`"
          },
          {
            "title": "Sign Out",
            "icon": "log-out"
          }
        ]
      }
    }
  }
}
