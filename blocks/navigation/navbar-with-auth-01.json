{
  "root": "navbar-auth",
  "elements": {
    "navbar-auth": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": 0
      },
      "children": [
        "nav-bar"
      ]
    },
    "nav-bar": {
      "type": "Surface",
      "props": {
        "variant": "card"
      },
      "children": [
        "nav-inner"
      ]
    },
    "nav-inner": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": 4,
        "align": "center",
        "justify": "between"
      },
      "children": [
        "nav-left",
        "auth-actions"
      ]
    },
    "nav-left": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": 4,
        "align": "center"
      },
      "children": [
        "nav-brand",
        "nav-links"
      ]
    },
    "nav-brand": {
      "type": "Text",
      "props": {
        "tag": "span",
        "content": "Vaultwise",
        "weight": "bold"
      }
    },
    "nav-links": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": 3,
        "align": "center"
      },
      "children": [
        "link-features",
        "link-security",
        "link-docs",
        "link-blog"
      ]
    },
    "link-features": {
      "type": "Link",
      "props": {
        "label": "Features",
        "href": "/features"
      }
    },
    "link-security": {
      "type": "Link",
      "props": {
        "label": "Security",
        "href": "/security"
      }
    },
    "link-docs": {
      "type": "Link",
      "props": {
        "label": "Docs",
        "href": "/docs"
      }
    },
    "link-blog": {
      "type": "Link",
      "props": {
        "label": "Blog",
        "href": "/blog"
      }
    },
    "auth-actions": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": 2,
        "align": "center"
      },
      "children": [
        "auth-login-btn",
        "auth-signup-btn"
      ]
    },
    "auth-login-btn": {
      "type": "Button",
      "props": {
        "label": "Log In",
        "variant": "ghost",
        "size": "sm"
      }
    },
    "auth-signup-btn": {
      "type": "Button",
      "props": {
        "label": "Create Account",
        "variant": "primary",
        "size": "sm"
      }
    }
  }
}
