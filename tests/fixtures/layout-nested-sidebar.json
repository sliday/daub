{
  "root": "root",
  "theme": "light",
  "elements": {
    "root": { "type": "Stack", "props": { "direction": "horizontal", "gap": 6, "align": "start" }, "children": ["scriptOnly", "navColumn", "pageBody", "cssOnly"] },
    "navColumn": { "type": "Stack", "props": { "gap": 4 }, "children": ["brand", "search", "navSidebar"] },
    "brand": { "type": "Text", "props": { "content": "Layout fixture", "tag": "h3" } },
    "search": { "type": "Search", "props": { "placeholder": "Search" } },
    "navSidebar": { "type": "Sidebar", "props": { "sections": [{ "title": "Discover", "items": [{ "label": "Home", "href": "#home", "active": true }] }] } },
    "pageBody": { "type": "Stack", "props": { "direction": "horizontal", "gap": 6, "align": "start" }, "children": ["feedColumn", "rightRail"] },
    "feedColumn": { "type": "Stack", "props": { "gap": 4 }, "children": ["stories", "post", "customMarkup", "customChildren"] },
    "stories": { "type": "Card", "children": ["storyRow"] },
    "storyRow": { "type": "Stack", "props": { "direction": "horizontal", "gap": 3 }, "children": ["storyA", "storyB", "storyC"] },
    "storyA": { "type": "Stack", "props": { "gap": 1, "align": "center" }, "children": ["avatarA", "nameA"] },
    "storyB": { "type": "Stack", "props": { "gap": 1, "align": "center" }, "children": ["avatarB", "nameB"] },
    "storyC": { "type": "Stack", "props": { "gap": 1, "align": "center" }, "children": ["avatarC", "nameC"] },
    "avatarA": { "type": "Avatar", "props": { "initials": "AL" } },
    "avatarB": { "type": "Avatar", "props": { "initials": "GH" } },
    "avatarC": { "type": "Avatar", "props": { "initials": "KT" } },
    "nameA": { "type": "Text", "props": { "content": "Ada", "tag": "span" } },
    "nameB": { "type": "Text", "props": { "content": "Grace", "tag": "span" } },
    "nameC": { "type": "Text", "props": { "content": "Katherine", "tag": "span" } },
    "post": { "type": "Card", "children": ["wideImage", "actionRow", "toolbar"] },
    "wideImage": { "type": "Image", "props": { "src": "/og-image.png", "alt": "Wide intrinsic image" } },
    "actionRow": { "type": "Stack", "props": { "direction": "horizontal", "justify": "between", "align": "center" }, "children": ["actionGroup", "save"] },
    "actionGroup": { "type": "Stack", "props": { "direction": "horizontal", "gap": 1 }, "children": ["helperAction", "reply"] },
    "helperAction": { "type": "Button", "props": { "label": "Like" } },
    "reply": { "type": "Button", "props": { "label": "Reply" } },
    "save": { "type": "Button", "props": { "label": "Save" } },
    "toolbar": { "type": "Toolbar", "props": { "label": "Formatting" }, "children": ["bold", "italic"] },
    "bold": { "type": "Toggle", "props": { "label": "Bold" } },
    "italic": { "type": "Toggle", "props": { "label": "Italic" } },
    "rightRail": { "type": "Stack", "props": { "gap": 4 }, "children": ["railCard"] },
    "railCard": { "type": "Card", "props": { "title": "Suggested for you" }, "children": ["railText"] },
    "railText": { "type": "Text", "props": { "content": "Photographers to follow." } },
    "scriptOnly": { "type": "CustomHTML", "props": { "forId": "helperAction", "html": "  ", "css": "[data-spec-id=\"helperAction\"] { --layout-helper: intact; }", "js": "container.dataset.helperReady = 'yes'; container.addEventListener('click', function () { container.dataset.helperClicks = String(Number(container.dataset.helperClicks || 0) + 1); });" } },
    "cssOnly": { "type": "CustomHTML", "props": { "css": "[data-layout-markup] { color: rgb(12, 34, 56); }" } },
    "customMarkup": { "type": "CustomHTML", "props": { "html": "<p data-layout-markup=\"intact\">Custom markup</p>", "css": "[data-layout-markup] { border-top: 2px solid rgb(12, 34, 56); }" } },
    "customChildren": { "type": "CustomHTML", "props": { "css": "[data-spec-id=\"customChild\"] { font-weight: 600; }" }, "children": ["customChild"] },
    "customChild": { "type": "Text", "props": { "content": "Rendered child" } }
  }
}
